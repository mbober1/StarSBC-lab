part u-boot --source rawcopy --sourceparams="file=${UBOOT_BINARY}" --ondisk mmcblk --no-table --align 1
part /boot  --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --align 4096 --size 16
part /      --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs_A --align 4096 --size=153
part /      --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs_B --align 4096 --size=153
part /data --fixed-size 100M --ondisk mmcblk --fstype=ext4 --label data --align 8192

bootloader --ptable msdos
