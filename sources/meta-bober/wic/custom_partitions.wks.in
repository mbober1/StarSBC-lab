part u-boot --source rawcopy --sourceparams="file=${UBOOT_BINARY}" --ondisk mmcblk --no-table --align 1
part /boot  --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --align 4096 --size 16
part /      --source rootfs --ondisk mmcblk --fstype=ext4 --label rootA --align 4096 --use-uuid --size=153 --active
part /      --source rootfs --ondisk mmcblk --fstype=ext4 --label rootB --align 4096 --use-uuid --size=153
part /home  --source rootfs --ondisk mmcblk --fstype=ext4 --label data  --change-directory=home 

bootloader --ptable msdos
